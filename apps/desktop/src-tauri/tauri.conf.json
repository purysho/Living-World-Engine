{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Living World Engine",
  "version": "0.3.0",
  "identifier": "com.livingworldengine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Living World Engine", "width": 1500, "height": 950, "minWidth": 1100, "minHeight": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "A persistent, simulated world for tabletop campaigns",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
