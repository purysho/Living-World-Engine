 "lenses": {
  "gm_craft": "Running the table: pacing, spotlight, improvisation, session structure, player agency, actual-play craft",
  "hard_science": "Hard SF: physics-first extrapolation, engineering problem-solving, deep time, ecology, alien minds, institutions under physical constraint",
  "economy_trade": "Markets, finance, trade, speculation and the psychology of money",
  "social_realism": "Society and interior life: class, family, marriage, moral psychology, generational sagas, historical sweep",
  "mystery": "Fair-play mystery and investigation: clues, misdirection, detective method, motive",
  "horror": "Supernatural, psychological and cosmic horror: dread, the uncanny, the limits of knowledge",
  "hard_magic": "Rule-bound magic systems, costs and limits, progression, magic as technology or economy",
  "politics_war": "Power, intrigue, statecraft, logistics, military campaigns, moral ambiguity, villains with coherent motives",
  "myth_worldbuilding": "Deep worldbuilding: languages, myth, the weird city, folklore, cultures, wonder, humane satire",
  "romance_relationships": "Romance, desire, loyalty and found family; relationship arcs with stakes",
  "food_culture": "Cuisine, material culture and everyday life as worldbuilding",
  "visual_art": "Illustration, creature and character design, visual tone",
  "scholarship": "Criticism and scholarship of speculative fiction",
  "villain_function": "Fictional adversaries studied for narrative function only — never treated as advisers or quoted as authors"
 },
